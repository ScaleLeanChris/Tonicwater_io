{
  "name": "tonicwater-io",
  "version": "3.0.0",
  "description": "The perfect gin & tonic pairing algorithm",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "dev:cf": "wrangler pages dev public --binding GIN_DATA=GinDataDO",
    "deploy": "bash DEPLOY_NOW.sh",
    "deploy:manual": "wrangler pages deploy public",
    "deploy:production": "wrangler pages deploy public --project-name tonicwater-io --branch=main",
    "deploy:preview": "wrangler pages deploy public --project-name tonicwater-io --branch=preview",
    "deploy:check": "npx wrangler whoami",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run test"
  },
  "keywords": ["gin", "tonic", "cocktail", "pairing", "cloudflare"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "wrangler": "^3.22.0",
    "@cloudflare/workers-types": "^4.20231218.0",
    "typescript": "^5.3.3"
  }
}
